		"@sveltejs/adapter-cloudflare": "^7.1.2",
		"@sveltejs/kit": "^2.22.0",
		"@sveltejs/vite-plugin-svelte": "^6.0.0",
		"@tailwindcss/typography": "^0.5.15",
		"@tailwindcss/vite": "^4.0.0",
		"@types/geojson": "^7946.0.16",
		"@types/papaparse": "^5.3.16",
		"citty": "^0.1.6",
		"eslint": "^9.18.0",
