		"tailwindcss": "^4.0.0",
		"tsx": "^4.20.3",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.20.0",
		"valibot": "^1.1.0",
		"vite": "^7.0.4",
		"vitest": "^4.1.10"
